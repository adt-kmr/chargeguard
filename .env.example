# Copy to .env and fill in locally. .env is git-ignored; never commit real values.

# Dashboard
CHARGEGUARD_PORT=8000
CHARGEGUARD_NO_BROWSER=

# Attestation backend: software | tpm2-tss | wolftpm
CHARGEGUARD_TPM_BACKEND=software
CHARGEGUARD_TPM_TCTI=mssim:host=127.0.0.1,port=2321

# Keylime verifier (mutual TLS: keep certificate and key files outside the repo)
CHARGEGUARD_KEYLIME_VERIFIER=https://127.0.0.1:8881
CHARGEGUARD_KEYLIME_CERT=
CHARGEGUARD_KEYLIME_KEY=
CHARGEGUARD_KEYLIME_CA=

# Llama advisor (ExecuTorch). Model files live in models/, which is git-ignored.
CHARGEGUARD_LLAMA_PTE=models/llama3_2_1b.pte
CHARGEGUARD_LLAMA_TOKENIZER=models/tokenizer.model
CHARGEGUARD_LLAMA_RUNNER=models/llama_main

# Cosign signing key password (the key itself must stay outside the repo)
COSIGN_PASSWORD=
